                    <h6 class="m-0 fw-bold text-primary"><i class="fa-solid fa-camera me-2"></i>Scan Wajah</h6>
                    <span class="badge bg-danger animate-pulse">LIVE</span>
                </div>
                
                <div class="card-body bg-dark p-0" style="min-height: 400px; position: relative; overflow: hidden;">
    
    <img src="{{ url_for('video_feed') }}" style="width: 100%; height: 100%; object-fit: cover;">
    
    <div class="scan-line"></div>

</div>

<style>
    .scan-line {
        position: absolute;
        width: 100%;
        height: 5px;
        background: rgba(0, 255, 0, 0.5);
        box-shadow: 0 0 10px rgba(0, 255, 0, 0.8);
        top: 0;
        animation: scanAnimation 3s infinite linear;

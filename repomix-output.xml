        <div id="box-status" class="alert alert-secondary d-flex align-items-center p-2 mb-0" role="alert">
            <i id="icon-status" class="fa-solid fa-spinner fa-spin fs-3 me-3"></i>
            <div>
                <span id="text-status" class="fw-bold d-block">Mencari Lokasi...</span>

               = <div class="card-footer bg-white p-3">
                    <button id="btn-absen" onclick="konfirmasiAbsen()" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">
    <i class="fa-solid fa-fingerprint me-2"></i>ABSEN SEKARANG
</button>                                   
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // --- FITUR AUTO UPDATE JARAK (REAL-TIME) ---
    
    // Jalankan saat halaman baru dibuka
    document.addEventListener("DOMContentLoaded", function() {
        updateJarakRealtime();
        // Lalu jalankan ulang setiap 5 detik (5000ms)
        setInterval(updateJarakRealtime, 5000);
    });

    function updateJarakRealtime() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function(position) {
                const lat = position.coords.latitude;
                const long = position.coords.longitude;
                
                // Panggil API Python
                fetch('/api/cek_jarak', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ latitude: lat, longitude: long }),
                })
                .then(response => response.json())
                .then(data => {
                    // Update Tampilan HTML
                    document.getElementById("text-jarak").innerText = "Jarak: " + data.jarak + " Meter dari Kantor";
                    document.getElementById("text-status").innerText = data.status_text;
                    
                    // Ganti Warna & Icon
                    const box = document.getElementById("box-status");
                    const icon = document.getElementById("icon-status");
                    
                    // Reset Class lama
                    box.className = "alert d-flex align-items-center p-2 mb-0 " + data.status_class;
                    icon.className = "fa-solid fs-3 me-3 " + data.icon;
                });
            });
        }
    }

    // FUNGSI 1: TAMPILKAN KONFIRMASI DULU
    function konfirmasiAbsen() {
        Swal.fire({
            title: 'Konfirmasi Absensi',
            text: "Apakah Anda yakin ingin melakukan absen saat ini?",
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#0d6efd',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Ya, Absen Sekarang!',
            cancelButtonText: 'Batal'
        }).then((result) => {
            if (result.isConfirmed) {
                // Jika User klik YA, baru jalankan proses asli
                ambilLokasiDanAbsen();
            }
        })
    }

    // FUNGSI 2: PROSES INTI (GPS & REQUEST)
    function ambilLokasiDanAbsen() {
        const btn = document.getElementById("btn-absen");
        
        // Ubah tombol jadi Loading biar gak bisa dipencet lagi (Anti-Spam Klik)
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Sedang Memproses...';
        btn.disabled = true;

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(kirimDataKePython, errorLokasi);
        } else {
            Swal.fire('Error', "Browser Anda tidak mendukung GPS!", 'error');
            resetTombol();
        }
    }

    function errorLokasi(err) {
        Swal.fire('Gagal!', 'Akses Lokasi Ditolak. Harap izinkan GPS.', 'error');
        resetTombol();
    }

    function resetTombol() {
        const btn = document.getElementById("btn-absen");
        btn.innerHTML = '<i class="fa-solid fa-fingerprint me-2"></i>ABSEN SEKARANG';
        btn.disabled = false;
    }

    function kirimDataKePython(position) {
        const lat = position.coords.latitude;
        const long = position.coords.longitude;

        fetch('/proses_absen', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ latitude: lat, longitude: long }),
        })
        .then(response => response.json())
        .then(data => {
            if (data.status === 'success') {
                Swal.fire({
                    title: 'Berhasil!',
                    text: data.pesan + ' (Jarak: ' + data.jarak + ')',
                    icon: 'success',
                    timer: 3000
                });
            } else {
                Swal.fire('Gagal!', data.pesan, 'error');
            }
            resetTombol();
        })
        .catch((error) => {
            console.error('Error:', error);
            Swal.fire('Error Sistem', 'Terjadi kesalahan koneksi.', 'error');
            resetTombol();
        });
    }
</script>

{% endblock %}
</file>

<file path="templates/izin.html">
{% extends "base.html" %}

{% block content %}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-white py-3">
                    <h5 class="m-0 fw-bold text-primary"><i class="fa-solid fa-envelope-open-text me-2"></i>Form Pengajuan Izin</h5>
                </div>
                <div class="card-body p-4">
                    
                    <form action="/izin" method="POST" enctype="multipart/form-data">
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Tanggal Mulai</label>
                                <input type="date" name="tgl_mulai" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Tanggal Selesai</label>
                                <input type="date" name="tgl_selesai" class="form-control" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Jenis Izin</label>
                            <select name="tipe_izin" class="form-select" required>
                                <option value="Sakit">Sakit (Wajib Surat Dokter)</option>
                                <option value="Cuti">Cuti Tahunan</option>
                                <option value="Penting">Keperluan Penting</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Keterangan / Alasan</label>
                            <textarea name="keterangan" class="form-control" rows="3" placeholder="Jelaskan alasan izin Anda..." required></textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Upload Bukti (Foto/Surat)</label>
                            <input type="file" name="bukti_foto" class="form-control" accept="image/*" required>
                            <small class="text-muted">Format: JPG/PNG. Maks 2MB.</small>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary fw-bold py-2">
                                <i class="fa-solid fa-paper-plane me-2"></i>KIRIM PENGAJUAN
                            </button>
                            <a href="/dashboard" class="btn btn-light text-secondary">Batal & Kembali</a>
                        </div>

                    </form>
                </div>
            </div>

            <div class="mt-4">
                <h6 class="fw-bold mb-3">Riwayat Pengajuan Terakhir</h6>
                {% if riwayat %}
                    <div class="list-group">
                        {% for r in riwayat %}
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0 fw-bold">{{ r[2] }} ({{ r[0] }} s/d {{ r[1] }})</h6>
                                <small class="text-muted">{{ r[3] }}</small>
                            </div>
                            {% if r[4] == 'Pending' %}
                                <span class="badge bg-warning text-dark">Menunggu</span>
                            {% elif r[4] == 'Disetujui' %}
                                <span class="badge bg-success">Disetujui</span>
                            {% else %}
                                <span class="badge bg-danger">Ditolak</span>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="alert alert-light text-center">Belum ada riwayat pengajuan.</div>
                {% endif %}
            </div>

        </div>
    </div>
</div>
{% endblock %}
</file>


                                            <i class="fa-solid fa-image"></i> Lihat
                                        </a>
                                    </td>
                                    <td>
                                        <a href="/admin/approve/{{ item[0] }}" class="btn btn-success btn-sm" title="Setujui"><i class="fa-solid fa-check"></i></a>
                                        <a href="/admin/reject/{{ item[0] }}" class="btn btn-danger btn-sm" title="Tolak"><i class="fa-solid fa-xmark"></i></a>

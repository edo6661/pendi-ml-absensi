<file path="templates/ambil_dataset.html">
{% extends "base.html" %} {% block content %}
<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-md-8 text-center">
      <h4 class="fw-bold mb-3">Pengambilan Dataset: {{ nama_user }}</h4>

      <div class="card shadow-lg mb-4 bg-dark">
        <div class="card-body p-1">
          <video id="video-webcam" autoplay playsinline width="100%"></video>
          <canvas id="canvas-foto" style="display: none"></canvas>
        </div>
      </div>

      <div class="card shadow-sm">
        <div class="card-body">
          <h5 id="instruksi" class="fw-bold text-primary mb-3">
            SIAP? Klik Tombol di Bawah
          </h5>

          <div class="progress mb-3" style="height: 25px">
            <div
              id="progressBar"
              class="progress-bar progress-bar-striped progress-bar-animated bg-success"
              role="progressbar"
              style="width: 0%"
            >
              0%
            </div>
          </div>

          <div id="btn-container">
            <button
              onclick="mulaiSesi(1)"
              class="btn btn-primary btn-lg w-100 mb-2"
            >
              MULAI SESI 1: Wajah Datar
            </button>
          </div>

          <div id="status" class="text-muted small mt-2">
            Menunggu perintah...
          </div>
        </div>
      </div>

      <div class="mt-3">
        <a href="/admin/users" class="btn btn-light">Kembali ke Kelola User</a>
      </div>
    </div>
  </div>
</div>

<script>
  const video = document.getElementById("video-webcam");

  // Meminta izin akses webcam ke browser
  navigator.mediaDevices
    .getUserMedia({ video: true })
    .then(function (stream) {
      video.srcObject = stream;
    })
    .catch(function (err) {
      console.error("Gagal mengakses kamera: ", err);
      alert("Harap izinkan akses kamera di browser!");
    });

  let userId = parseInt("{{ user_id }}");
  let totalFoto = 0;
  let countSesi = 0; // Target 20 per sesi

  // Daftar Instruksi
  const sesiList = [
    { id: 1, text: "Sesi 1: WAJAH DATAR", btnNext: "MULAI" },
    { id: 2, text: "Sesi 2: WAJAH SENYUM", btnNext: "MULAI" },
    { id: 3, text: "Sesi 3: WAJAH SERONG KIRI", btnNext: "MULAI" },
    { id: 4, text: "Sesi 4: WAJAH SERONG KANAN", btnNext: "MULAI" },
  ];

  function mulaiSesi(nomorSesi) {
    let config = sesiList[nomorSesi - 1];
    document.getElementById("instruksi").innerText = "MEREKAM: " + config.text;

    document.getElementById("btn-container").innerHTML =
      '<button class="btn btn-secondary disabled w-100">Sedang Merekam...</button>';

    countSesi = 0;
    ambilSatuFoto(nomorSesi);
  }

  function ambilSatuFoto(nomorSesi) {
    if (countSesi >= 20) {
      siapkanSesiBerikutnya(nomorSesi);
      return;
    }

    if (video.videoWidth === 0 || video.videoHeight === 0) {
      document.getElementById("status").innerText =
        "Menunggu kamera siap/fokus...";
      setTimeout(() => ambilSatuFoto(nomorSesi), 500);
      return;
    }

    totalFoto++;

    const canvas = document.getElementById("canvas-foto");
    const context = canvas.getContext("2d");

    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    context.drawImage(video, 0, 0, canvas.width, canvas.height);

    // MENGHAPUS HEADER BASE64 SEBELUM DIKIRIM KE PYTHON
    const rawData = canvas.toDataURL("image/jpeg");
    const imageData = rawData.split(",")[1];

    fetch("/api/simpan_frame_base64", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        user_id: userId,
        urutan: totalFoto,
        image: imageData,
      }),
    })
      .then((response) => response.json())
      .then((data) => {
        if (data.status === "success") {
          countSesi++;
          updateProgress();
          document.getElementById("status").innerText =
            "Foto tersimpan: " + countSesi + "/20 (Total: " + totalFoto + ")";

          // Jeda sedikit lebih lama (500ms) agar server aman
          setTimeout(() => {
            ambilSatuFoto(nomorSesi);
          }, 500);
        } else {
          totalFoto--;
          document.getElementById("status").innerText =
            "Mencari wajah... (Pastikan wajah di kotak terang)";

          // Jeda diperlama jadi 1.5 detik jika error, agar server tidak spamming error
          setTimeout(() => {
            ambilSatuFoto(nomorSesi);
          }, 1500);
        }
      })
      .catch((err) => {
        console.error(err);
        totalFoto--;
        setTimeout(() => {
          ambilSatuFoto(nomorSesi);
        }, 1500);
      });
  }

  function updateProgress() {
    let persen = (countSesi / 20) * 100;
    document.getElementById("progressBar").style.width = persen + "%";
    document.getElementById("progressBar").innerText = Math.round(persen) + "%";
  }

  function siapkanSesiBerikutnya(nomorSesi) {
    if (nomorSesi < 4) {
      let nextConfig = sesiList[nomorSesi];
      document.getElementById("instruksi").innerText =
        "ISTIRAHAT SEBENTAR. SIAPKAN POSE BERIKUTNYA.";
      document.getElementById("btn-container").innerHTML =
        `<button onclick="mulaiSesi(${nomorSesi + 1})" class="btn btn-warning btn-lg w-100 fw-bold">${nextConfig.btnNext}</button>`;

      document.getElementById("progressBar").className =
        "progress-bar bg-warning";
    } else {
      document.getElementById("instruksi").innerText =
        "PENGAMBILAN DATA SELESAI!";
      document.getElementById("instruksi").className =
        "fw-bold text-success mb-3";
      document.getElementById("progressBar").className =
        "progress-bar bg-success";
      document.getElementById("btn-container").innerHTML =
        `<a href="/admin/users" class="btn btn-success btn-lg w-100 fw-bold">KEMBALI & TRAINING MODEL</a>`;
    }
  }
</script>
{% endblock %}
</file>

</files>

